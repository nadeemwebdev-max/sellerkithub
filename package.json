{
  "name": "sellerkit-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "dev": "npm run dev --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "deploy": "npm run build && npx wrangler pages deploy frontend/dist --project-name=sellerkithub --branch=main"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
