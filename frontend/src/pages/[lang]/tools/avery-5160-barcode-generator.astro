---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BarcodeGenerator from '../../../views/BarcodeGenerator.jsx';

export function getStaticPaths() {
  return ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<BaseLayout lang={lang}>
  <BarcodeGenerator client:load initialType="code128" initialTemplateId="avery-5160" lang={lang} />
</BaseLayout>
