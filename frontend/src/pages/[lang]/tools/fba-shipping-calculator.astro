---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AmazonCalculator from '../../../views/AmazonCalculator.jsx';

export function getStaticPaths() {
  return ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<BaseLayout lang={lang}>
  <AmazonCalculator client:idle isShippingRoute={true} lang={lang} />
</BaseLayout>
