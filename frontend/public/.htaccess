# ==============================================================================
# Hostinger Apache / LiteSpeed Production Configuration for SellerKitHub
# ==============================================================================

# Ensure DirectoryIndex finds index.html first
DirectoryIndex index.html

# 1. Canonical Domain (Force HTTPS and non-WWW) & 301 URL Aliases
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /


  # 301 Permanent Redirects for Legacy Short URLs to Canonical /tools/ Paths
  RewriteRule ^etsy-fee-calculator/?$ /tools/etsy-fee-calculator [R=301,L]
  RewriteRule ^etsy-digital-fee-calculator/?$ /tools/etsy-digital-fee-calculator [R=301,L]
  RewriteRule ^amazon-fee-calculator/?$ /tools/amazon-fba-calculator [R=301,L]
  RewriteRule ^fba-shipping-calculator/?$ /tools/fba-shipping-calculator [R=301,L]
  RewriteRule ^walmart-fee-calculator/?$ /tools/walmart-fee-calculator [R=301,L]
  RewriteRule ^margin-matrix/?$ /tools/profit-margin-calculator [R=301,L]
  RewriteRule ^roas-calculator/?$ /tools/roas-calculator [R=301,L]
  RewriteRule ^gst-calculator/?$ /tools/gst-calculator [R=301,L]
  RewriteRule ^marketplace-comparison/?$ /tools/marketplace-comparison [R=301,L]
  RewriteRule ^batch-calculator/?$ /tools/batch-calculator [R=301,L]
  RewriteRule ^product-image-resizer/?$ /tools/product-image-resizer [R=301,L]
  RewriteRule ^barcode-generator/?$ /tools/barcode-generator [R=301,L]
  RewriteRule ^avery-qr-code-generator/?$ /tools/avery-qr-code-generator [R=301,L]
  RewriteRule ^avery-5160-barcode-generator/?$ /tools/avery-5160-barcode-generator [R=301,L]

  # Ensure root index.html is not rewritten in a loop
  RewriteRule ^index\.html$ - [L]

  # If requested directory contains an index.html (prerendered route), serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Serve existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all other URLs to root index.html for React Router SPA
  RewriteRule . /index.html [L]
</IfModule>

# 2. MIME Types Configuration
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType application/json json
  AddType font/woff2 woff2
  AddType font/woff woff
  AddType image/webp webp
  AddType video/mp4 mp4
</IfModule>

# 3. GZIP / Brotli Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 application/vnd.ms-fontobject
</IfModule>

# 4. Browser Caching Rules
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default expiration: 1 hour
  ExpiresDefault "access plus 1 hour"
  
  # HTML & JSON (Revalidate so new builds take effect immediately)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  
  # Static hashed assets (Vite generates unique cache-busting hashes in filenames)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# 5. Cache-Control Header Fine-Tuning
<IfModule mod_headers.c>
  # Ensure HTML and JSON are revalidated so visitors get fresh releases immediately
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache hashed static assets aggressively
  <FilesMatch "\.(js|css|woff2|woff|svg|png|jpg|jpeg|webp|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security & Performance Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
